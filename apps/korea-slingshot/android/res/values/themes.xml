<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The WebView reports prefers-color-scheme from this theme, so the page follows the phone's dark mode. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/sea</item>
        <item name="android:statusBarColor">@color/sea</item>
        <item name="android:navigationBarColor">@color/sea</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
